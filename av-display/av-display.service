# Starts AV Display at power-on, full screen on the HDMI output. Installed by install.sh.
[Unit]
Description=AV Display slideshow
After=local-fs.target systemd-user-sessions.service
# Take over the first screen instead of showing a login prompt there.
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
ExecStart=/usr/local/bin/av-display
Restart=always
RestartSec=3
StandardInput=tty
TTYPath=/dev/tty1
# Messages go to the log (journalctl -u av-display), not onto the screen.
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=multi-user.target
